{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "pokeget random --hide-name",
    "position": "left",
  },
  "display": {
    "separator": "",
    "key": {
      "width": 20,
    },
  },
  "modules": [
    {
      "type": "title",
      "key": "  user@hname",
      "keyColor": "31",
    },
    {
      "type": "os",
      "key":"{icon} distro",
      "keyColor": "32",
      "format": "{2}",
    },
    {
      "type": "shell",
      "key": "  shell",
      "keyColor": "33",
      "format": "{1}",
    },
    {
      "type": "wm",
      "key": "  desktop",
      "keyColor": "34",
      "format": "{1}",
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "35",
      "format": "{1}",
    },
    {
      "type": "terminalfont",
      "key": " font",
      "keyColor": "36",
    },
    {
      "type": "colors",
      "key": "  colors",
      "keyColor": "37",
      "symbol": "circle",
    }
  ]
}
