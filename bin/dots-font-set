#!/bin/bash

font_name="$1"

if [[ -z $font_name ]]; then
  echo "Usage: dots-font-set <font-name>"
  exit 1
fi

if ! fc-list | grep -iq "$font_name"; then
  echo "Font '$font_name' not found on system."
  exit 1
fi

if [[ -f ~/.dots/source/kitty/kitty.conf ]]; then
  sed -i "s/^font_family .*/font_family $font_name/g" ~/.dots/source/kitty/kitty.conf
  pkill -USR1 kitty
fi

if [[ -f ~/.dots/source/waybar/style.css ]]; then
  sed -i "s/font-family: .*/font-family: '$font_name';/g" ~/.dots/source/waybar/style.css
  if pgrep -x waybar >/dev/null; then
    killall -SIGUSR2 waybar
  fi
fi

if [[ -f ~/.dots/source/hypr/looknfeel.conf ]]; then
  sed -i "s/font_family = .*/font_family = $font_name/g" ~/.dots/source/hypr/looknfeel.conf
fi

if [[ -f ~/.dots/source/rofi/config.rasi ]]; then
  sed -i "s/font:.*;/font:                        \"$font_name 10\";/g" ~/.dots/source/rofi/config.rasi
fi

if [[ -f ~/.dots/source/swayosd/style.css ]]; then
  sed -i "s/font-family: '[^']*'/font-family: '$font_name'/g" ~/.dots/source/swayosd/style.css
fi

if [[ -f ~/.dots/config/fontconfig/fonts.conf ]]; then
  sed -i "/<string>monospace<\/string>/,/<\/match>/ s|<string>[^<]*Nerd Font[^<]*</string>|<string>$font_name</string>|" ~/.dots/config/fontconfig/fonts.conf
fi

echo "Font set to '$font_name'"