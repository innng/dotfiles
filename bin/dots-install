#!/bin/bash

set -e

DOTS_DIR="$HOME/.dots"
CONFIG_DIR="$HOME/.config"

echo "Installing dotfiles..."

find "$DOTS_DIR/config" -type f | while read -r file; do
    rel="${file#$DOTS_DIR/config/}"
    mkdir -p "$CONFIG_DIR/$(dirname "$rel")"
    cp "$file" "$CONFIG_DIR/$rel"
done

echo "Dotfiles installed to $CONFIG_DIR"
echo "Run 'dots-theme-set <theme>' to apply a theme."