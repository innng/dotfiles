#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: dots-theme-set <theme-name>"
  exit 1
fi

THEMES_DIR="$HOME/.dots/themes"
OUTPUT_DIR="$HOME/.config/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $THEMES_DIR/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

rm -rf "$OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

cp -r "$THEMES_DIR/$THEME_NAME/"* "$OUTPUT_DIR/"

echo "$THEME_NAME" >"$OUTPUT_DIR/name"

dots-theme-set-templates

gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"

# Icon theme
ICONS_FILE="$OUTPUT_DIR/icons.theme"
if [[ -f $ICONS_FILE ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$(<$ICONS_FILE)"
fi

if pgrep -x waybar >/dev/null; then
  killall -SIGUSR2 waybar
fi
if pgrep -x mako >/dev/null; then
  killall -SIGHUP mako
fi
if pgrep -x swayosd >/dev/null; then
  killall -SIGUSR1 swayosd
fi
if pgrep -x kitty >/dev/null; then
  killall -SIGUSR1 kitty
fi

hyprctl reload

# btop theme symlink
mkdir -p "$HOME/.config/btop/themes"
ln -sf "$OUTPUT_DIR/btop.theme" "$HOME/.config/btop/themes/current.theme"

if pgrep -x btop >/dev/null; then
  killall -SIGUSR2 btop
fi

# wlogout theme
mkdir -p "$HOME/.config/wlogout"
if [[ -f "$OUTPUT_DIR/wlogout.css" ]]; then
  cp "$OUTPUT_DIR/wlogout.css" "$HOME/.config/wlogout/style.css"
fi

# Vencord theme symlink
VENCORD_THEMES_DIR="$HOME/.config/Vencord/themes"
if [[ -d $VENCORD_THEMES_DIR ]]; then
  ln -sf "$OUTPUT_DIR/discord.css" "$VENCORD_THEMES_DIR/theme.css"
fi

# Spotify (Spicetify)
if [[ -f "$OUTPUT_DIR/spotify.ini" ]] && command -v spicetify >/dev/null; then
  SPICETIFY_USER_THEMES="$HOME/.config/spicetify/Themes"
  ZIRO_SRC=""
  for dir in /opt/spicetify-cli/Themes/Ziro /usr/share/spicetify/Themes/Ziro; do
    if [[ -d "$dir" ]]; then
      ZIRO_SRC="$dir"
      break
    fi
  done
  ZIRO_DIR="$SPICETIFY_USER_THEMES/Ziro"
  if [[ -n $ZIRO_SRC ]]; then
    mkdir -p "$SPICETIFY_USER_THEMES"
    cp -r "$ZIRO_SRC" "$ZIRO_DIR"
  fi
  if [[ -d "$ZIRO_DIR" ]]; then
    SPOTIFY_SCHEME=$(grep -oP '^\[\K[^\]]+' "$OUTPUT_DIR/spotify.ini" | head -1)
    # Remove existing section if present, then append ours
    sed -i "/^\[${SPOTIFY_SCHEME}\]/,/^\[/{/^\[${SPOTIFY_SCHEME}\]/d;/^\[/!d}" "$ZIRO_DIR/color.ini"
    printf '\n' >> "$ZIRO_DIR/color.ini"
    cat "$OUTPUT_DIR/spotify.ini" >> "$ZIRO_DIR/color.ini"
    spicetify config current_theme Ziro
    spicetify config color_scheme "$SPOTIFY_SCHEME"
    spicetify apply
  fi
fi

# OpenCode theme
OPENCODE_THEMES_DIR="$HOME/.config/opencode/themes"
if [[ -d $OPENCODE_THEMES_DIR ]] && [[ -f "$OUTPUT_DIR/opencode.json" ]]; then
  cp "$OUTPUT_DIR/opencode.json" "$OPENCODE_THEMES_DIR/$THEME_NAME.json"
fi

# Telegram theme
if [[ -f "$OUTPUT_DIR/telegram.theme" ]]; then
  TELEGRAM_URL=$(cat "$OUTPUT_DIR/telegram.theme")
  xdg-open "$TELEGRAM_URL" 2>/dev/null || true
  echo "  updated telegram theme (confirm in app)"
fi

# Firefox theme (via Firefox Color)
if [[ -f "$OUTPUT_DIR/firefox.theme" ]]; then
  FIREFOX_URL=$(cat "$OUTPUT_DIR/firefox.theme")
  xdg-open "$FIREFOX_URL" 2>/dev/null || true
  echo "  updated firefox theme (confirm in app)"
fi

# Zen Browser theme
ZEN_DIR="$HOME/.config/zen"
if [[ -d "$ZEN_DIR" ]]; then
  ZEN_PROFILE=""
  while IFS= read -r line; do
    if [[ $line =~ ^Path= ]]; then
      Zen_PATH="${line#Path=}"
      if [[ -d "$ZEN_DIR/$Zen_PATH" ]]; then
        ZEN_PROFILE="$ZEN_DIR/$Zen_PATH"
        break
      fi
    fi
  done < <(grep -E '^Path=' "$ZEN_DIR/profiles.ini" 2>/dev/null)

  if [[ -n "$ZEN_PROFILE" && -d "$ZEN_PROFILE" ]]; then
    # Enable legacy stylesheets
    if ! grep -q 'toolkit.legacyUserProfileCustomizations' "$ZEN_PROFILE/prefs.js" 2>/dev/null; then
      echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >> "$ZEN_PROFILE/prefs.js"
    fi
    # Force dark mode
    if ! grep -q 'ui.systemUsesDarkTheme' "$ZEN_PROFILE/prefs.js" 2>/dev/null; then
      echo 'user_pref("layout.css.prefers-color-scheme.content-enabled", 1);' >> "$ZEN_PROFILE/prefs.js"
      echo 'user_pref("ui.systemUsesDarkTheme", 2);' >> "$ZEN_PROFILE/prefs.js"
    fi

    mkdir -p "$ZEN_PROFILE/chrome" 2>/dev/null
    for f in userChrome.css userContent.css; do
      if [[ -f "$OUTPUT_DIR/zen/$f" ]]; then
        cp "$OUTPUT_DIR/zen/$f" "$ZEN_PROFILE/chrome/$f"
        echo "  updated zen $f"
      fi
    done
    if [[ -f "$OUTPUT_DIR/zen/zen-logo.svg" ]]; then
      mkdir -p "$ZEN_PROFILE/data/profile-icons" 2>/dev/null
      cp "$OUTPUT_DIR/zen/zen-logo.svg" "$ZEN_PROFILE/data/profile-icons/" 2>/dev/null || true
      echo "  updated zen logo"
    fi
    echo "  updated zen theme (restarting zen...)"

    pkill -f zen-browser 2>/dev/null || true
    sleep 1
    nohup zen-browser &>/dev/null 2>&1 &
    sleep 3
    echo "  updated zen theme (restarted)"
  else
    echo "  skipped zen theme (no profile found)"
  fi
else
  echo "  skipped zen theme (not installed)"
fi